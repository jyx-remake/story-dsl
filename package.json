{
  "name": "story-dsl-workspace",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/vscode-extension",
    "packages/web"
  ],
  "scripts": {
    "build:core": "npm run build --workspace @storydsl/core",
    "build": "npm run build --workspace storydsl-vscode",
    "build:web": "npm run build --workspace storydsl-web",
    "dev:web": "npm run dev --workspace storydsl-web",
    "test": "npm test --workspace storydsl-vscode",
    "package:vsix": "npm run package:vsix --workspace storydsl-vscode"
  }
}
