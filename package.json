{
  "name": "story-dsl-workspace",
  "private": true,
  "scripts": {
    "install:core": "npm install --prefix packages/core",
    "install:vscode": "npm install --prefix packages/vscode-extension",
    "install:web": "npm install --prefix packages/web",
    "build:core": "npm --prefix packages/core run build",
    "build": "npm --prefix packages/vscode-extension run build",
    "build:web": "npm --prefix packages/web run build",
    "dev:web": "npm --prefix packages/web run dev",
    "test": "npm --prefix packages/vscode-extension run test",
    "package:vsix": "npm --prefix packages/vscode-extension run package:vsix"
  }
}
