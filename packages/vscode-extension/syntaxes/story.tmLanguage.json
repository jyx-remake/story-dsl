{
  "scopeName": "source.storydsl",
  "name": "Story DSL",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#segment"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#branch"
    },
    {
      "include": "#dialogue"
    },
    {
      "include": "#presentationStyle"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#number"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.storydsl",
      "match": "//.*$"
    },
    "segment": {
      "patterns": [
        {
          "name": "entity.name.section.storydsl",
          "match": "^#\\s*.+$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.storydsl",
          "match": "\\b(if|elif|else|when|battle|jump|call|return|and|or|not|win|lose|timeout)\\b|&&|\\|\\||!"
        }
      ]
    },
    "branch": {
      "patterns": [
        {
          "name": "punctuation.definition.list.storydsl",
          "match": "^\\s*-\\s+"
        }
      ]
    },
    "dialogue": {
      "patterns": [
        {
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.storydsl"
            },
            "2": {
              "name": "punctuation.separator.key-value.storydsl"
            }
          },
          "begin": "^\\s*([^:/：\\n]*?)\\s*([:：])\\s*",
          "contentName": "string.unquoted.storydsl",
          "end": "$",
          "patterns": [
            {
              "include": "#presentationStyle"
            },
            {
              "include": "#richText"
            }
          ]
        }
      ]
    },
    "presentationStyle": {
      "patterns": [
        {
          "name": "meta.annotation.presentation.storydsl",
          "match": "\\[#\\s*style\\s*=\\s*[^\\]\\s]+\\s*\\]"
        }
      ]
    },
    "richText": {
      "patterns": [
        {
          "name": "markup.other.storydsl",
          "match": "\\[/?color(?:=[A-Za-z]+)?\\]"
        }
      ]
    },
    "variable": {
      "patterns": [
        {
          "name": "variable.other.readwrite.storydsl",
          "match": "\\$[^\\s()!<>=&|/:：]+"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.storydsl",
          "match": "(?<![\\w.])-?\\d+(?:\\.\\d+)?\\b"
        }
      ]
    }
  }
}
